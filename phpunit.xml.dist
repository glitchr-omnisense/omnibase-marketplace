<?xml version="1.0" encoding="UTF-8"?>
<!-- bootstrap="tests/bootstrap.php" rather than vendor/autoload.php: installed
     inside a host application, that application's autoloader never picks up
     this bundle's autoload-dev, so the bootstrap registers the test namespace
     itself - the same dual-runner pattern as base-bundle and base-bundle-forum. -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" colors="true" beStrictAboutOutputDuringTests="true" bootstrap="tests/bootstrap.php">
  <!-- Each kernel test boots the host application whole (a hundred and more),
       each released at its tearDown (MarketplaceKernelTestCase): the suite peaks
       near 245 MB, 285 MB with the transmission's tests (omnisense/omnibill
       loaded), in omnisense/omnibase's harness. -->
  <php>
    <ini name="memory_limit" value="512M"/>
  </php>
  <testsuites>
    <testsuite name="unit">
      <directory>tests</directory>
    </testsuite>
  </testsuites>
  <coverage>
    <include>
      <directory>src</directory>
    </include>
  </coverage>
</phpunit>
